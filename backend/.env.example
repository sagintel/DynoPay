# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public HTTPS origin of this API (PayPal redirects here). Use a tunnel (ngrok/cloudflared) in dev.
PUBLIC_URL=http://localhost:4000
# Deep-link scheme of the mobile app (app.json "scheme").
APP_SCHEME=dynopay
# Comma-separated list of allowed browser origins (Expo web). Native apps send no Origin.
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=info

# ─── Database (Sequelize) ─────────────────────────────────────────────────
# SQLite by default. Switch with no code changes:
#   postgres://user:pass@host:5432/dynopay   (npm i pg pg-hstore)
#   mysql://user:pass@host:3306/dynopay      (npm i mysql2)
DATABASE_URL=sqlite:./data/dynopay.sqlite
# Run sequelize.sync({ alter }) on boot. Keep false in production and use migrations.
DB_SYNC_ALTER=false

# ─── Auth ─────────────────────────────────────────────────────────────────
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Allows POST /v1/auth/dev (demo user, seeded data). Always ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN=true

# ─── PayPal ───────────────────────────────────────────────────────────────
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the PayPal developer dashboard (for signature verification).
PAYPAL_WEBHOOK_ID=
# Encrypts merchant REST API secrets at rest (32 bytes, base64). Required in production.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
# Currency used for wallets/top-ups/payouts.
DEFAULT_CURRENCY=USD

# ─── AI (ReAct agent) ─────────────────────────────────────────────────────
# gemini | cloudflare | offline   (offline = rule-based planner, no LLM)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
# Max Thought/Action/Observation iterations per request.
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_MS=45000

# ─── Guardrails (server-enforced, independent of the agent) ───────────────
# Per-transfer and rolling 24h limits, in major units.
LIMIT_PER_TRANSFER=5000
LIMIT_DAILY_OUT=10000
# Shared secret for POST /v1/internal/run-schedules (cron).
CRON_SECRET=change-me
